using SlackOfDescent;
using System.Text.Json;

int assertions = 0;
void Expect(bool condition, string message) { assertions++; if (!condition) throw new Exception(message); }
var document = NativeCharacterDocument.Create();
var hat = document.Definition.Parts[1]; var tail = document.Definition.Parts[2];
document.BeginEdit();
document.Paint(hat.Id, 0, 3, 4, 11, 25, 230, 128);
document.Paint(hat.Id, 0, 4, 5, 67, 33, 19, 0);
document.EndEdit();
Expect(document.UndoCount == 1, "one brush stroke is one undo");
var source = document.Copy(hat.Id, 0, new(3, 4, 3, 3));
Expect(source.Rgba[3] == 128 && source.Rgba[(1 * 3 + 1) * 4] == 67 && source.Rgba[(1 * 3 + 1) * 4 + 3] == 0, "copy preserves alpha and invisible RGB");
var clipboard = NativePixelClipboard.Decode(source.Encode())!;
Expect(clipboard.Rgba.SequenceEqual(source.Rgba), "clipboard survives encoded OS transport");
Expect(NativePixelClipboard.Decode("other clipboard text") is null, "unrelated text is ignored");
Expect(NativePixelClipboard.Decode("slack-rgba-v1:" + Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes("{\"Width\":2,\"Height\":2,\"Rgba\":null}"))) is null, "malformed clipboard with null pixels is ignored");
document.Paste(tail.Id, 0, clipboard, 7, 8);
Expect(document.Copy(tail.Id, 0, new(7, 8, 3, 3)).Rgba.SequenceEqual(source.Rgba), "cross part paste replaces all RGBA channels");
document.Undo(); tail = document.Definition.Parts.Single(p => p.Id == tail.Id);
Expect(document.Pixels(tail, 0).All(b => b == 0), "paste undo restores blank part");
document.Redo(); tail = document.Definition.Parts.Single(p => p.Id == tail.Id);
Expect(document.Copy(tail.Id, 0, new(7, 8, 3, 3)).Rgba.SequenceEqual(source.Rgba), "paste redo restores exact pixels");
int copiedFrame = document.AddFrame(tail.Id, 0);
Expect(document.Pixels(tail, copiedFrame).SequenceEqual(document.Pixels(tail, 0)), "frame duplication has matching pixel content");
document.Paint(tail.Id, copiedFrame, 0, 0, 1, 2, 3, 255);
Expect(document.Pixels(tail, 0)[3] == 0, "duplicated frames own separate data");
document.Paste(tail.Id, 0, clipboard, -1, -1);
Expect(document.Pixels(tail, 0)[0] == 67 && document.Pixels(tail, 0)[3] == 0, "negative paste clips while preserving source rectangle offset");
var imported = NativeCharacterDocument.Create(); var importedPart = imported.Definition.Parts[0];
byte[] importedPixels = [255, 30, 40, 255, 11, 22, 33, 0, 40, 255, 80, 128, 90, 80, 255, 255];
imported.ImportFrames(importedPart.Id, [new(2, 2, importedPixels), new(2, 2, importedPixels.Reverse().ToArray())], anchorX: 11, anchorY: 19);
Expect(importedPart.Frames.Count == 2 && importedPart.AnchorX == 11 && importedPart.AnchorY == 19, "original frame import retains skeleton anchors");
importedPixels[0] = 0;
Expect(imported.Pixels(importedPart, 0)[0] == 255 && imported.Pixels(importedPart, 0)[7] == 0, "imported frames own RGBA data including invisible RGB");
imported.Undo();
Expect(imported.Definition.Parts[0].Width == 32 && imported.Definition.Parts[0].Frames.Count == 1, "one undo restores the complete part before frame import");
var encoded = NativeCharacterPng.Encode(source.Width, source.Height, source.Rgba);
Expect(NativeCharacterPng.Decode(encoded).Rgba.SequenceEqual(source.Rgba), "PNG roundtrip preserves byte exact transparent RGB");
encoded[20] ^= 1; bool invalid = false; try { NativeCharacterPng.Decode(encoded); } catch (InvalidDataException) { invalid = true; }
Expect(invalid, "corrupt PNG CRC is rejected");
string temporary = Path.Combine(Path.GetTempPath(), "native-character-tests-" + Guid.NewGuid().ToString("N"));
try
{
    var store = new NativeContentStore(temporary); var registry = new ContentRegistry(); var repository = new NativeCharacterRepository(store);
    document.Definition.Dependencies.Add("missing.action.pack"); document.Definition.Actions[CharacterActionSlot.Jump] = "missing.action.pack.jump";
    document.Definition.Extra = new() { ["future"] = JsonSerializer.SerializeToElement(new { preserved = "未知值" }) };
    tail.Extra = new() { ["futurePart"] = JsonSerializer.SerializeToElement(71) };
    tail.Frames[0].Extra = new() { ["futureFrame"] = JsonSerializer.SerializeToElement(true) };
    tail.AnchorX = 11; tail.OffsetY = -4; tail.Layer = -9;
    repository.Save(document, registry);
    Expect(!document.Dirty, "successful save establishes clean baseline");
    document.Undo(); document.Redo();
    Expect(!document.Dirty, "redo to saved content ignores immutable storage revision changes");
    tail = document.Definition.Parts.Single(p => p.Id == tail.Id);
    Expect(registry.Characters.ContainsKey(document.Definition.Id), "saved characters are available immediately");
    string firstAsset = document.Definition.Parts[0].Frames[0].Png;
    var loaded = repository.Load(document.Definition.Id); var loadedTail = loaded.Definition.Parts.Single(p => p.Id == tail.Id);
    Expect(loaded.Definition.Id == document.Definition.Id, "save and load retain stable ID");
    Expect(loadedTail.AnchorX == 11 && loadedTail.OffsetY == -4 && loadedTail.Layer == -9, "part transform persists independently");
    Expect(loaded.Definition.Dependencies.SequenceEqual(document.Definition.Dependencies) && loaded.Definition.Actions[CharacterActionSlot.Jump] == "missing.action.pack.jump", "missing dependencies and actions remain intact");
    Expect(loaded.Definition.Extra!["future"].GetProperty("preserved").GetString() == "未知值" && loadedTail.Extra!["futurePart"].GetInt32() == 71 && loadedTail.Frames[0].Extra!["futureFrame"].GetBoolean(), "unknown JSON survives at definition, part and frame levels");
    foreach (var part in document.Definition.Parts) for (int f = 0; f < part.Frames.Count; f++) Expect(document.Pixels(part, f).SequenceEqual(loaded.Pixels(loaded.Definition.Parts.Single(p => p.Id == part.Id), f)), "saved frame equals loaded frame");
    bool overwrite = false; try { repository.Save(loaded, registry); } catch (IOException) { overwrite = true; }
    Expect(overwrite, "overwrite needs explicit consent");
    repository.Save(loaded, registry, true);
    Expect(firstAsset != loaded.Definition.Parts[0].Frames[0].Png && File.Exists(Path.Combine(store.Characters, firstAsset)), "atomic manifest save points to immutable new assets");
    var restarted = new ContentRegistry(); repository.Discover(restarted);
    Expect(restarted.Characters.ContainsKey(document.Definition.Id), "restart discovers saved character");
    var missing = loaded.Duplicate(); missing.Definition.Parts[0].Frames[0].Png = "../../escape.png";
    invalid = false; try { repository.LoadDefinition(missing.Definition); } catch (InvalidDataException) { invalid = true; }
    Expect(invalid, "asset paths cannot escape content directory");
    string missingPath=loaded.Definition.Parts[0].Frames[0].Png;
    File.Delete(repository.FramePath(loaded.Definition.Parts[0].Frames[0]));
    var unresolved=repository.Load(loaded.Definition.Id);
    Expect(unresolved.MissingFrames.Count==1,"missing PNG reported while document remains editable");
    unresolved.Definition.Name="资源缺失仍可保存";repository.Save(unresolved,registry,true);
    Expect(repository.Load(loaded.Definition.Id).Definition.Parts[0].Frames[0].Png==missingPath,"save preserves unavailable PNG dependency");
    var unresolvedPart=unresolved.Definition.Parts[0];unresolved.Paint(unresolvedPart.Id,0,1,1,11,22,33,128);repository.Save(unresolved,registry,true);
    Expect(unresolved.MissingFrames.Count==0&&repository.Load(unresolved.Definition.Id).Pixels(unresolvedPart.Frames[0].Id)[(1*unresolvedPart.Width+1)*4+3]==128,"painting a missing frame saves explicit RGBA replacement");
    var bad = new CharacterDefinition { Id = "../escape" }; invalid = false; try { new NativeCharacterDocument(bad); } catch (InvalidDataException) { invalid = true; }
    Expect(invalid, "character ID cannot escape content directory");
}
finally { Directory.Delete(temporary, true); }
Console.WriteLine($"CHARACTER_MODEL_TESTS_OK assertions={assertions}");
