<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <Optimize>true</Optimize>
    <IncludeDiagnostics Condition="'$(IncludeDiagnostics)' == ''">false</IncludeDiagnostics>
    <DefineConstants Condition="'$(IncludeDiagnostics)' == 'true'">$(DefineConstants);INCLUDE_DIAGNOSTICS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests/**/*.cs" />
    <Compile Remove="Runtime/Diagnostics/**/*.cs" Condition="'$(IncludeDiagnostics)' != 'true'" />
    <Compile Remove="Examples/Mods/**/*.cs" />
    <Reference Include="Microsoft.CodeAnalysis">
      <HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp">
      <HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CopyModReferences" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath);$(TargetDir)GodotSharp.dll" DestinationFolder="$(MSBuildProjectDirectory)/Tools/ModCompiler/References" SkipUnchangedFiles="true" />
  </Target>
</Project>
